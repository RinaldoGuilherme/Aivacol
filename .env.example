# Application
NODE_ENV=development
APP_PORT=3000

# SQL Server
DB_HOST=sqlserver
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=your_strong_password2026
DB_DATABASE=aivacol_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_TTL_SECONDS=60

# RabbitMQ (container provisioning)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_MANAGEMENT_PORT=15672

# RabbitMQ (application connection URL)
# Note: URL-encode special characters in the password (e.g. @ -> %40).
RABBITMQ_URL=amqp://guest:your_rabbitmq_password@rabbitmq:5672
RABBITMQ_QUEUE=vehicle_events

# MongoDB (container provisioning)
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=aivacol_audit
MONGO_USERNAME=admin
MONGO_PASSWORD=your_mongo_password

# MongoDB (application connection URI)
MONGODB_URI=mongodb://admin:your_mongo_password@mongodb:27017/aivacol_audit?authSource=admin

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=3600s
